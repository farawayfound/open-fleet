# Copy to .env (or point OBS_ENV at a private env file). This file holds NO secrets.
# Secrets are generated into observability/.secrets/ (mode 0700, gitignored).
# setup.sh sources this file as shell and passes it to docker compose as --env-file, so a value with a space
# must be double-quoted.

# The stack version lives here and nowhere else. Bump all three together (the preflight checks the tags agree).
STACK_VERSION=9.5.6
# Full image refs. Pin by digest for stronger supply-chain control, e.g. ...:9.5.6@sha256:<digest>.
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.5.6
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.5.6

# Address both services bind to (plus loopback). Must be assigned to this host and must not be 0.0.0.0.
TAILNET_IP=100.64.0.10
# IP SANs for the Elasticsearch certificate. Must include TAILNET_IP and 127.0.0.1.
ES_CERT_IPS=127.0.0.1,100.64.0.10
ES_CERT_DNS=es01,localhost
# Rendered into kibana.yml as server.publicBaseUrl. Default: http://$TAILNET_IP:5601
#KIBANA_PUBLIC_URL=http://100.64.0.10:5601

CLUSTER_NAME=fleet-obs
# Elasticsearch: 2 GB heap inside a 4 GB container. Kibana: 1.5 GB container.
ES_JAVA_OPTS="-Xms2g -Xmx2g"
ES_MEM_LIMIT=4g
KIBANA_MEM_LIMIT=1536m
# A path starting with ./ or / (a bare name would become a named volume). setup.sh creates it 0700 for uid 1000.
ES_SNAPSHOT_DIR=./snapshots

# Kibana package version installed through the Fleet EPM API (must match the fleetctl step's SYSTEM_PKG_VERSION).
SYSTEM_PKG_VERSION=3.5.0

# Retention. This is the ILM delete phase min_age, which counts from ROLLOVER (every 7 days or 30 GB per primary
# shard), so a document is deleted between RETENTION_DAYS and RETENTION_DAYS + 7 days after it was written.
RETENTION_DAYS=31
# Disk safety. Watermarks are ABSOLUTE FREE-SPACE values and apply to the whole filesystem.
WM_LOW_FREE=100gb
WM_HIGH_FREE=60gb
WM_FLOOD_FREE=30gb
OBS_MIN_FREE_GB=120
OBS_MIN_AVAIL_MEM_GB=8
